#EXERCICIO 9 
def resumo_emprestimo(capital, taxa_anual, anos):
    r = taxa_anual / 12 / 100
    n = anos * 12

    M = capital * (r * ((1 + r) ** n)) / (((1 + r) ** n) - 1)
    total_pago = M * n

    return f"9 - Empréstimo: R$ {capital:.2f} | Parcela Mensal: R$ {M:.2f} | Total Pago: R$ {total_pago:.2f}"


print(resumo_emprestimo(10000, 6.0, 3))

