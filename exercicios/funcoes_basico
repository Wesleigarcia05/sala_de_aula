#EXERCICIO 7
def metricas_cilindro(raio:float, altura:float):
    pi = 3.14159
    volume = pi * (raio**2) * altura
    area_superficie = 2 * pi * raio * (raio + altura)
    return f" 7 - Volume do cilindro: {volume:.2f} | Área de superficie: {area_superficie:.2f}"
print(metricas_cilindro(2.0, 5.0))



