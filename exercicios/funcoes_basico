def calcular_distancia(x1, y1, x2, y2):
    distancia = ((x2 - x1) ** 2 + (y2 - y1) ** 2) ** 0.5

    return f"10 - A distância entre ({x1}, {y1}) e ({x2}, {y2}) é de {distancia:.2f} unidades."


